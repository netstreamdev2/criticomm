# React Native autolinking and Gradle resolve packages by walking real
# directories, not pnpm's symlinked store. Under the default isolated linker
# they find inconsistent copies — which is how the generated PackageList.java
# ended up importing expo.core.ExpoModulesPackage, a class path retired in
# SDK 43.
#
# Full `node-linker=hoisted` fixes that but is NOT usable here: it collapses
# @types/react 19 (web, React 19) and @types/react 18 (mobile, React 18.3.1)
# into one root copy where they shadow each other and both apps stop
# typechecking. This repo spans two React majors.
#
# So hoist only the packages the native toolchain has to agree on. @types/*
# stays isolated per workspace, which is the part that must not be shared.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react-native-*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=@babel/runtime
