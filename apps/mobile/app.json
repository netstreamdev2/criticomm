{
  "expo": {
    "name": "HikTech Responder",
    "slug": "criticom-responder",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "criticom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#050510",
    "icon": "./assets/branding/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.ethekwini.criticom",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Criticom shares your live position with dispatch while you are on duty.",
        "NSCameraUsageDescription": "Capture incident-scene evidence photos.",
        "NSMicrophoneUsageDescription": "Record voice notes as incident evidence.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Criticom records your route for dispatch while you are on duty, also with the screen off."
      }
    },
    "android": {
      "package": "za.co.ethekwini.criticom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "monochromeImage": "./assets/branding/monochrome-icon.png",
        "backgroundColor": "#050510"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#050510"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Criticom shares your live position with dispatch while you are on duty.",
          "locationAlwaysAndWhenInUsePermission": "Criticom records your route for dispatch while you are on duty, also with the screen off.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library as incident evidence."
        }
      ],
      "expo-asset",
      "expo-font",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "./plugins/with-radio-keys"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "netstreamdevtests-team",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "65165cef-bcc7-4de5-8701-79056bbf62f0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/65165cef-bcc7-4de5-8701-79056bbf62f0",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
