{
  "expo": {
    "name": "Criticom Responder",
    "slug": "criticom-responder",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "criticom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#050510",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.ethekwini.criticom",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Criticom shares your live position with dispatch while you are on duty.",
        "NSCameraUsageDescription": "Capture incident-scene evidence photos.",
        "NSMicrophoneUsageDescription": "Record voice notes as incident evidence.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "za.co.ethekwini.criticom",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Criticom shares your live position with dispatch while you are on duty."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library as incident evidence."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#dc3545",
          "defaultChannel": "dispatch"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "kruzen22",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f0dde5d8-3714-4335-ab03-74e1c63d8337"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
