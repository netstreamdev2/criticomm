# Supabase — public values (safe in client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Invitation callbacks. Use this same host in the browser and Supabase allowlist.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Mobile reads from EXPO_PUBLIC_* (Expo's convention)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# The web console the app calls for server features, including activating
# an account with a printed code. HTTPS in production.
EXPO_PUBLIC_APP_URL=http://127.0.0.1:3000

# Server-only — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Account invitations (migration 0049) — server-only. docs/10-STAFF-ONBOARDING.md
# Invitation links use NEXT_PUBLIC_APP_URL, which must be HTTPS in production.
# Invitation emails go through this mail server. Without SMTP_HOST and
# SMTP_FROM, a development server shows the administrator the link to pass on;
# production offers only SMS and printed codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HikTech <no-reply@example.org>"
# Key for the keyed hashes of invitation links and codes. Falls back to the
# service role key; give production its own long random value
# (openssl rand -base64 48). Changing it voids every unaccepted invitation.
INVITATION_SECRET=
# How long a link or code stays valid, in hours: 1 to 168, default 72.
INVITE_TTL_HOURS=72
# Optional: where field staff download the phone app, shown once they activate.
NEXT_PUBLIC_APP_DOWNLOAD_URL=

# External integrations (Edge Functions only — stored in Supabase Vault in prod)
SENDGRID_API_KEY=
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
MARINESIA_API_KEY=
FLIGHTRADAR_API_KEY=
GEMINI_API_KEY=
# BulkSMS also carries SMS invitations from the web server once both are set.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=

# Bodycams (migration 0054) — the Hikvision platform's OpenAPI (HCM Lite).
# Server-only. The AppKey and AppSecret come from the platform's administrator;
# base_url and the other settings live in Admin → Integrations → Hikvision.
HIKVISION_APP_KEY=
HIKVISION_APP_SECRET=
# Hosts the browser may play bodycam video from (the platform's streaming
# addresses), space- or comma-separated, e.g. https://hcm.durban.gov.za:1443.
# The public sample stream is always allowed. Changing this needs a redeploy.
BODYCAM_STREAM_ORIGINS=
