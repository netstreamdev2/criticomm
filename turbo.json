{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_APP_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_DB_URL",
    "OPENWEATHER_API_KEY",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "TOMTOM_API_KEY",
    "FLIGHTRADAR_API_KEY",
    "MARINESIA_API_KEY",
    "ITRAFFIC_API_KEY",
    "BULKSMS_TOKEN_ID",
    "BULKSMS_TOKEN_SECRET",
    "REALPTT_ACCOUNT",
    "REALPTT_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
