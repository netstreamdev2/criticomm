{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_DOWNLOAD_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "INVITATION_SECRET",
    "INVITE_TTL_HOURS",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_DB_URL",
    "OPENWEATHER_API_KEY",
    "WEATHER_PASS_SECRET",
    "XAI_API_KEY",
    "XAI_MODEL",
    "GROQ_API_KEY",
    "GROQ_MODEL",
    "CRITI_PROVIDERS",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "TOMTOM_API_KEY",
    "HIKVISION_APP_KEY",
    "HIKVISION_APP_SECRET",
    "BODYCAM_STREAM_ORIGINS",
    "BODYCAM_FFMPEG_PATH",
    "BODYCAM_HLS_VCODEC",
    "FLIGHTRADAR_API_KEY",
    "MARINESIA_API_KEY",
    "ITRAFFIC_API_KEY",
    "BULKSMS_TOKEN_ID",
    "BULKSMS_TOKEN_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
