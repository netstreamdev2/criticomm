{
  "name": "@criticom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./incidents": "./src/incidents/index.ts",
    "./personnel": "./src/personnel/index.ts",
    "./shift": "./src/shift/index.ts",
    "./realtime": "./src/realtime/index.ts",
